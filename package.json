{
  "name": "chess-lessons",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "start": "node src/server.js",
    "test": "mocha 'test/**/*.test.js' --require test/helpers/setup.js",
    "test:unit": "mocha 'test/unit/**/*.test.js' --require test/helpers/setup.js",
    "test:integration": "mocha 'test/integration/**/*.test.js' --require test/helpers/setup.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:coverage": "c8 npm test",
    "test:watch": "mocha 'test/**/*.test.js' --require test/helpers/setup.js --watch"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "c8": "^8.0.1",
    "chai": "^4.3.10",
    "cheerio": "^1.0.0-rc.12",
    "jsdom": "^23.0.0",
    "mocha": "^10.2.0",
    "node-fetch": "^2.7.0",
    "sinon": "^17.0.1",
    "supertest": "^6.3.3"
  }
}
